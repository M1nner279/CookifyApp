{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=CookifyDb;User Id=sa;Password=YourStrong!Pass123;TrustServerCertificate=True"
  },
  
  "Cloudinary": {
    "CloudName": "replace-me",
    "ApiKey": "replace-me",
    "ApiSecret": "replace-me"
  },
  
  "AuthSettings": {
    "Key": "replace-me",
    "Issuer": "CookifyAPI",
    "Audience": "CookifyClient",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7,
    "SkipVerification": false
  },
  
  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "Port": 587,
    "SenderName": "Cookify App",
    "SenderEmail": "replace-me",
    "Password": "replace-me"
  },
  
  "IdentityOptions": {
    "Password": {
      "RequireDigit": true,
      "RequiredLength": 6,
      "RequireNonAlphanumeric": false,
      "RequireUppercase": false,
      "RequireLowercase": false
    },
    "User": {
      "RequireUniqueEmail": true
    },
    "SignIn": {
      "RequireConfirmedEmail": true
    }
  }
}
